<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlexFamilyCalendar.ViewModels"
             xmlns:cv="using:FlexFamilyCalendar.Converters"
             xmlns:loc="using:FlexFamilyCalendar.Localization"
             xmlns:ctrl="using:FlexFamilyCalendar.Controls"
             x:Class="FlexFamilyCalendar.Views.EntryEditorView"
             x:CompileBindings="False">

  <UserControl.Resources>
    <cv:ColorStringToBrushConverter x:Key="ColorStringToBrushConverter" />
    <cv:HexToColorConverter x:Key="HexToColorConverter" />
  </UserControl.Resources>

  <Grid Margin="24,20,24,20" RowDefinitions="Auto,*,Auto" MinWidth="432">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="{Binding DateLabel}" Opacity="0.6" FontSize="13" Margin="0,2,0,0" />
    </StackPanel>

    <!-- Formular -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="600">
      <StackPanel Spacing="14">

        <!-- Eintrag oder Abwesenheit — nur beim Anlegen durch den Admin. Keine Typ-Auswahl mehr:
             ein normaler Eintrag heißt, wie man ihn nennt; nur Abwesenheiten haben eine Art. -->
        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding CanSwitchMode}">
          <RadioButton GroupName="EntryMode" Content="{loc:Tr Entry_ModeEntry}"
                       IsChecked="{Binding IsEntryMode, Mode=TwoWay}" />
          <RadioButton GroupName="EntryMode" Content="{loc:Tr Entry_ModeAbsence}"
                       IsChecked="{Binding IsAbsenceMode, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding CanPickUser}">
          <TextBlock Text="{loc:Tr Entry_User}" FontSize="12" Opacity="0.7" />
          <ComboBox ItemsSource="{Binding AvailableUsers}"
                    SelectedItem="{Binding SelectedUser}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- ─── Eintrag ─── -->

        <!-- Bezeichnung: das erste und wichtigste Feld — sie ist der Name im Plan. Schlägt beim
             Tippen vor, was schon vorkommt, bleibt aber frei. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsEntryMode}">
          <TextBlock Text="{Binding TitleLabel}" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
          <AutoCompleteBox Text="{Binding Title, Mode=TwoWay}"
                           ItemsSource="{Binding TitleSuggestions}"
                           FilterMode="ContainsOrdinal"
                           MinimumPrefixLength="1"
                           MaxDropDownHeight="220"
                           PlaceholderText="{Binding TitlePlaceholder}"
                           HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- ─── Abwesenheit ─── -->

        <StackPanel Spacing="4" IsVisible="{Binding IsAbsenceMode}">
          <TextBlock Text="{loc:Tr Entry_AbsenceKind}" FontSize="12" Opacity="0.7" />
          <ComboBox ItemsSource="{Binding AbsenceKinds}"
                    SelectedItem="{Binding SelectedAbsenceKind}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- ─── Beides: Start und Ende ─── -->

        <!-- Start und Ende UNTEREINANDER, je Datum + Uhrzeit (wie im Google-Kalender). Der
             Fluent-DatePicker ist mindestens ~296 px breit (Tag, Monat, Jahr) — nebeneinander
             passten zwei davon in keinen Dialog und schoben sich übereinander. Die Uhrzeit steht
             rechts daneben, größer und fetter als der Rest des Formulars. -->
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Entry_Start}" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
            <Grid ColumnDefinitions="*,Auto">
              <DatePicker Grid.Column="0" SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch" />
              <ctrl:TimeEntryBox Grid.Column="1" Margin="10,0,0,0"
                                 IsVisible="{Binding ShowTimes}"
                                 Time="{Binding StartTime, Mode=TwoWay}"
                                 FontSize="19" FontWeight="SemiBold"
                                 Width="96" Padding="10,7" />
            </Grid>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Entry_End}" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
            <Grid ColumnDefinitions="*,Auto">
              <DatePicker Grid.Column="0" SelectedDate="{Binding EndDate}" HorizontalAlignment="Stretch" />
              <ctrl:TimeEntryBox Grid.Column="1" Margin="10,0,0,0"
                                 IsVisible="{Binding ShowTimes}"
                                 Time="{Binding EndTime, Mode=TwoWay}"
                                 FontSize="19" FontWeight="SemiBold"
                                 Width="96" Padding="10,7" />
            </Grid>
          </StackPanel>
          <CheckBox IsChecked="{Binding IsAllDay}" Content="{loc:Tr Entry_AllDay}" />
        </StackPanel>

        <!-- Vermerk zur Abwesenheit (optional) — sehen nur die Person selbst und die Admins. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsAbsenceMode}">
          <TextBlock Text="{Binding TitleLabel}" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding Title}" PlaceholderText="{Binding TitlePlaceholder}" CornerRadius="6" />
        </StackPanel>

        <!-- ─── Beides ─── -->

        <!-- Kachelfarbe. Vorschau zeigt Grund UND Schrift so, wie die Kachel später im Plan
             aussieht — die Schriftfarbe wird gerechnet, nicht gewählt (EntryColors.OnTile). -->
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Entry_ColorLabel}" FontSize="12" Opacity="0.7"
                       VerticalAlignment="Center" />
            <Border Grid.Column="2" CornerRadius="4" Padding="8,3" MinWidth="86"
                    Background="{Binding PreviewColor, Converter={StaticResource ColorStringToBrushConverter}}">
              <TextBlock Text="{loc:Tr Entry_ColorPreview}" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center"
                         Foreground="{Binding PreviewForeground, Converter={StaticResource ColorStringToBrushConverter}}" />
            </Border>
          </Grid>

          <CheckBox IsChecked="{Binding UseCustomColor}" Content="{loc:Tr Entry_ColorCustom}" />

          <ColorView IsVisible="{Binding UseCustomColor}"
                     Color="{Binding Color, Converter={StaticResource HexToColorConverter}, Mode=TwoWay}"
                     HorizontalAlignment="Stretch"
                     IsAlphaEnabled="False"
                     IsColorPaletteVisible="True"
                     IsColorPreviewVisible="False"
                     IsColorComponentsVisible="True" />
        </StackPanel>

        <Border IsVisible="{Binding ShowOvernightNote}"
                Background="{DynamicResource SelectionFillBrush}" CornerRadius="6" Padding="10,8">
          <TextBlock Text="{Binding OvernightNote}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Entry_NotesLabel}" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding Notes}"
                   PlaceholderText="{loc:Tr Entry_NotesPlaceholder}"
                   AcceptsReturn="True"
                   Height="80"
                   TextWrapping="Wrap"
                   CornerRadius="6" />
        </StackPanel>

        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource DangerFillBrush}" CornerRadius="6" Padding="10,8">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13" TextWrapping="Wrap" />
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Buttons -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,12,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0"
              Content="{loc:Tr Common_Delete}"
              Command="{Binding DeleteCommand}"
              IsVisible="{Binding IsEditMode}"
              Padding="16,8" CornerRadius="6"
              Classes="danger-solid" />
      <Button Grid.Column="2"
              Content="{loc:Tr Common_Cancel}"
              Command="{Binding CancelCommand}"
              Padding="16,8" CornerRadius="6" />
      <Button Grid.Column="4"
              Content="{loc:Tr Common_Save}"
              Command="{Binding SaveCommand}"
              Padding="16,8" CornerRadius="6"
              Classes="accent" />
    </Grid>

  </Grid>
</UserControl>
