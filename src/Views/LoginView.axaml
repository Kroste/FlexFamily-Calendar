<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlexFamilyCalendar.ViewModels"
             xmlns:loc="using:FlexFamilyCalendar.Localization"
             xmlns:views="using:FlexFamilyCalendar.Views"
             x:Class="FlexFamilyCalendar.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             x:CompileBindings="False">

  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Classes="card"
            x:Name="LoginCard"
            CornerRadius="12"
            Padding="40,36"
            Width="380"
            BoxShadow="0 4 24 0 #40000000">
      <StackPanel Spacing="20">

        <!-- Sprachwahl -->
        <ComboBox x:Name="LanguageBox"
                  ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  HorizontalAlignment="Right" MinWidth="120">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Logo / Titel -->
        <StackPanel HorizontalAlignment="Center" Spacing="4">
          <Path Data="{StaticResource Icon.Calendar}"
                Stroke="{DynamicResource SystemControlForegroundAccentBrush}"
                StrokeThickness="2"
                Width="40" Height="40" Stretch="Uniform"
                HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Tr App_Title}"
                     Classes="h1"
                     HorizontalAlignment="Center" />
          <TextBlock IsVisible="{Binding IsFirstRun}"
                     Text="{loc:Tr Login_FirstRunSubtitle}"
                     Classes="muted" FontSize="13"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Felder -->
        <StackPanel Spacing="12">
          <StackPanel Spacing="4" IsVisible="{Binding IsFirstRun}">
            <TextBlock Text="{loc:Tr Login_DisplayName}" Classes="muted" FontSize="12" />
            <TextBox x:Name="DisplayNameBox"
                     Text="{Binding DisplayName}"
                     PlaceholderText="{loc:Tr Login_DisplayNamePlaceholder}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Login_Username}" Classes="muted" FontSize="12" />
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username}"
                     PlaceholderText="{loc:Tr Login_Username}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Login_Password}" Classes="muted" FontSize="12" />
            <TextBox x:Name="PasswordBox"
                     Text="{Binding Password}"
                     PlaceholderText="{loc:Tr Login_Password}"
                     PasswordChar="*" />
          </StackPanel>

          <CheckBox x:Name="RememberMeBox" IsChecked="{Binding RememberMe}" Content="{loc:Tr Login_RememberMe}"
                    views:Hint.Text="{loc:Tr Hint_Login_RememberMe}" />
        </StackPanel>

        <!-- Fehlermeldung -->
        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource DangerFillBrush}" CornerRadius="6" Padding="10,8">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13" />
        </Border>

        <!-- Buttons -->
        <Button x:Name="SignInButton"
                Classes="accent"
                IsVisible="{Binding !IsFirstRun}"
                Content="{loc:Tr Login_SignIn}"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding !IsLoading}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Height="40" />

        <Button x:Name="CreateAdminButton"
                Classes="accent"
                IsVisible="{Binding IsFirstRun}"
                Content="{loc:Tr Login_CreateAdmin}"
                Command="{Binding CreateAdminCommand}"
                IsEnabled="{Binding !IsLoading}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Height="40"
                Background="{DynamicResource SuccessBrush}"
                BorderBrush="{DynamicResource SuccessBrush}" />

        <!-- Ladeindikator -->
        <ProgressBar IsVisible="{Binding IsLoading}"
                     IsIndeterminate="True"
                     Height="3"
                     CornerRadius="2" />

        <!-- Verbindungs-Modus: lokal oder Server (URL einstellen) -->
        <Button x:Name="ConnectionButton"
                Classes="ghost"
                Content="{Binding ConnectionLabel}" Click="OnConnectionClick"
                HorizontalAlignment="Center" Padding="6,4"
                FontSize="11" Opacity="0.65" Cursor="Hand"
                views:Hint.Text="{loc:Tr Hint_Login_Connection}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
