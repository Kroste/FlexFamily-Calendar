<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="using:FlexFamilyCalendar.Converters"
             xmlns:loc="using:FlexFamilyCalendar.Localization"
             xmlns:ctrl="using:FlexFamilyCalendar.Controls"
             x:Class="FlexFamilyCalendar.Views.RecurringActivityManagementView"
             x:CompileBindings="False">

  <UserControl.Resources>
    <cv:ColorStringToBrushConverter x:Key="ColorStringToBrushConverter" />
    <cv:HexToColorConverter x:Key="HexToColorConverter" />
  </UserControl.Resources>

  <Grid Margin="16" ColumnDefinitions="280,16,*">

    <!-- Liste links -->
    <DockPanel Grid.Column="0">
      <Button DockPanel.Dock="Bottom" Content="{loc:Tr Recur_New}"
              Command="{Binding NewCommand}" Margin="0,8,0,0"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Padding="12,7" CornerRadius="6"
              Classes="accent" />
      <Border BorderThickness="1" CornerRadius="6"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <ListBox ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2" Margin="2,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding WeekdaysLabel}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding TimeRange}" FontWeight="SemiBold" Opacity="0.8" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                          Background="{Binding TileColor, Converter={StaticResource ColorStringToBrushConverter}}" />
                  <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding UserDisplayName}" FontSize="11" Opacity="0.6" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>

    <!-- Formular rechts -->
    <ScrollViewer Classes="form" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">

        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Entry_User}" FontSize="12" Opacity="0.7" />
          <ComboBox ItemsSource="{Binding AvailableUsers}" SelectedItem="{Binding SelectedUser}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Recur_Name}" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding Title}" PlaceholderText="{loc:Tr Recur_NamePlaceholder}"
                   MaxLength="80" CornerRadius="6" />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{loc:Tr Entry_StartTime}" FontSize="12" Opacity="0.7" />
            <ctrl:TimeEntryBox Time="{Binding StartTime, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="{loc:Tr Entry_EndTime}" FontSize="12" Opacity="0.7" />
            <ctrl:TimeEntryBox Time="{Binding EndTime, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Recur_Weekdays}" FontSize="12" Opacity="0.7" />
          <WrapPanel>
            <CheckBox Content="{loc:Tr Day_Mon}" IsChecked="{Binding Mon}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Tr Day_Tue}" IsChecked="{Binding Tue}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Tr Day_Wed}" IsChecked="{Binding Wed}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Tr Day_Thu}" IsChecked="{Binding Thu}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Tr Day_Fri}" IsChecked="{Binding Fri}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Tr Day_Sat}" IsChecked="{Binding Sat}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Tr Day_Sun}" IsChecked="{Binding Sun}" />
          </WrapPanel>
        </StackPanel>

        <CheckBox Content="{loc:Tr Recur_SkipOnHolidays}" IsChecked="{Binding SkipOnHolidays}" />

        <!-- Kachelfarbe — gleiche Bedienung wie im Eintrag-Dialog. Die Vorschau zeigt Grund und
             Schrift so, wie jede Kachel der Serie im Plan aussieht. -->
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Entry_ColorLabel}" FontSize="12" Opacity="0.7"
                       VerticalAlignment="Center" />
            <Border Grid.Column="2" CornerRadius="4" Padding="8,3" MinWidth="86"
                    Background="{Binding PreviewColor, Converter={StaticResource ColorStringToBrushConverter}}">
              <TextBlock Text="{loc:Tr Entry_ColorPreview}" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center"
                         Foreground="{Binding PreviewForeground, Converter={StaticResource ColorStringToBrushConverter}}" />
            </Border>
          </Grid>

          <CheckBox IsChecked="{Binding UseCustomColor}" Content="{loc:Tr Recur_ColorCustom}" />

          <ColorView IsVisible="{Binding UseCustomColor}"
                     Color="{Binding Color, Converter={StaticResource HexToColorConverter}, Mode=TwoWay}"
                     HorizontalAlignment="Stretch"
                     IsAlphaEnabled="False"
                     IsColorPaletteVisible="True"
                     IsColorPreviewVisible="False"
                     IsColorComponentsVisible="True" />
        </StackPanel>

        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource DangerFillBrush}" CornerRadius="6" Padding="10,8">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Content="{loc:Tr Common_Save}" Command="{Binding SaveCommand}"
                  Padding="16,8" CornerRadius="6"
                  Classes="accent" />
          <Button Content="{loc:Tr Common_Delete}" Command="{Binding DeleteCommand}"
                  IsEnabled="{Binding SelectedActivity, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Padding="16,8" CornerRadius="6" Classes="danger-solid" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
