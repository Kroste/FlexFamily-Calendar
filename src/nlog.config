<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${tempdir}/FlexFamilyCalendar/nlog-internal.log">

  <!-- ${masked:inner=${message}} maskiert Passwörter, Tokens und Connection-String-
       Credentials. Der Renderer registriert sich über einen ModuleInitializer, damit er
       auch im Testprozess (kein Main) vor dem ersten Logger steht. Bewusst direkt im
       Layout statt über eine <variable> — ob NLog einen Variablenwert erneut als Layout
       interpretiert, ist nicht garantiert, und ein stiller Ausfall der Maskierung wäre
       genau das, was hier nicht passieren darf. -->

  <!-- archiveAboveSize: Deckel pro Datei (10 MB), maxArchiveFiles begrenzt die Anzahl. Vorher
       wurde nur täglich rotiert — eine Schleife, die im Millisekundentakt loggt (Windows,
       Instanz-Pipe „Pipe is broken"), schrieb die Datei dann bis zum Tageswechsel voll. -->

  <targets>
    <target xsi:type="File"
            name="logfile"
            fileName="${specialfolder:folder=LocalApplicationData}/FlexFamilyCalendar/logs/flexfamily-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger:shortName=true} | ${masked:inner=${message}}${exception:format=toString,Data:separator=&#13;&#10;}"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            encoding="utf-8"
            createDirs="true" />

    <target xsi:type="Console"
            name="console"
            layout="${time} | ${level:uppercase=true} | ${masked:inner=${message}}${onexception:inner= | ${exception:format=toString}}" />
  </targets>

  <rules>
    <!-- Datei ab Trace (Kroste-Standard: im Zweifel loggen — zu viel Log ist billiger als
         ein nicht reproduzierbarer Bug), Konsole ab Info. -->
    <logger name="*" minlevel="Trace" writeTo="logfile" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
