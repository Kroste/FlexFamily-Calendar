<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Zentrale Farbpalette. Views referenzieren ausschließlich diese Keys — keine #RRGGBB-
    Literale im XAML (Kroste-Standard). Vorher lagen 89 Literale in 21 Views verstreut;
    dieselbe Semantik wurde dort mit leicht verschiedenen Tönen ausgedrückt, und eine
    Theme-Änderung hätte in jeder Datei einzeln nachgezogen werden müssen.

    Die Keys sind nach ihrer ROLLE benannt, nicht nach der Farbe: wer "Danger" sucht,
    findet es, auch wenn Rot irgendwann ein anderes Rot wird.

    Achtung bei Umbenennungen: ein toter {DynamicResource …}-Verweis erzeugt KEINEN
    Compile-Fehler, das Element rendert einfach falsch. ResourceKeyTests gleicht deshalb
    alle referenzierten gegen alle definierten Keys ab.
  -->

  <!-- ── Oberflächen-Rollen (theme-abhängig) ───────────────────────────────── -->
  <!--
    Der Kroste-Card-Look gibt die Rollen vor (Card, Border, Muted, Accent …), seine Farbwerte
    sind aber fix dunkel. FlexFamily lässt den Benutzer zwischen Hell, Dunkel und System
    wählen, deshalb liegen diese Rollen in ThemeDictionaries statt als feste Werte — sonst
    wäre der Hell-Modus unbrauchbar. Die Statusfarben weiter unten bleiben theme-neutral:
    Rot heißt in beiden Varianten dasselbe.
  -->
  <!--
    Warme Palette (v0.23): Terrakotta als Akzent, Creme statt Reinweiß, Braun- statt
    Blaugrau für Ränder und Nebentexte. Vorher Indigo auf Weiß — kühl, und das Blau des
    Akzents biss sich mit den Kachelfarben. Die Fluent-Grundfarben (Haken, Auswahl,
    Kalender-Kopf) ziehen über die Palettes in App.axaml mit; beides zusammen ändern.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F1E8" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFDF9" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#E8DDD0" />
      <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#D2C3B1" />
      <SolidColorBrush x:Key="FieldBrush" Color="#FFFDF9" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#7D6B5D" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A4A3F" />
      <SolidColorBrush x:Key="HeadingBrush" Color="#8A3A1E" />
      <SolidColorBrush x:Key="AccentBrush" Color="#C2572B" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#A8471F" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#8F3C1A" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1AC2572B" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GhostHoverBrush" Color="#143A2410" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#1AB23A2E" />
      <SolidColorBrush x:Key="DividerBrush" Color="#E8DDD0" />
      <!-- Heutiger Tag im Plan: zarte Akzent-Tönung statt des früheren Blaus. -->
      <SolidColorBrush x:Key="TodayFillBrush" Color="#16C2572B" />
      <!-- Abgesetzte Flächen in Dialogen (Einstellungen, KI-Planer, Pausen). -->
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F3EBE0" />
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8F2EA" />
      <!-- KI-Planer: Antwort-Blase und Vorschlagskarten. -->
      <SolidColorBrush x:Key="InfoCardBackgroundBrush" Color="#FBEEDD" />
      <SolidColorBrush x:Key="InfoCardBorderBrush" Color="#EBCDA8" />
      <SolidColorBrush x:Key="SuggestionCardBrush" Color="#FFFDF9" />
      <!-- Scrollbalken: Fluents eigene Keys überschrieben (App-Ressourcen gehen vor die des
           Themes). Die Namen stammen aus den Ressourcen des geladenen FluentTheme, nicht geraten.
           PanningThumb ist der dünne Strich im eingeklappten Zustand — vorher fast schwarz. -->
      <Color x:Key="ScrollBarThumbBackgroundColor">#B8A796</Color>
      <Color x:Key="ScrollBarPanningThumbBackgroundColor">#B8A796</Color>
      <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#B8A796" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#A8927E" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#C2572B" />
      <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#F3EBE0" />
      <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#F3EBE0" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#171310" />
      <SolidColorBrush x:Key="CardBrush" Color="#241E1A" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#3A302A" />
      <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#54463C" />
      <SolidColorBrush x:Key="FieldBrush" Color="#1C1714" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#A0907F" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CDBBAA" />
      <SolidColorBrush x:Key="HeadingBrush" Color="#F0A36B" />
      <SolidColorBrush x:Key="AccentBrush" Color="#D2693C" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#E07B4F" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#B8562D" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#33D2693C" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GhostHoverBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#33B23A2E" />
      <SolidColorBrush x:Key="DividerBrush" Color="#3A302A" />
      <SolidColorBrush x:Key="TodayFillBrush" Color="#22D2693C" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#2A221D" />
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="#211B17" />
      <SolidColorBrush x:Key="InfoCardBackgroundBrush" Color="#3A2A1C" />
      <SolidColorBrush x:Key="InfoCardBorderBrush" Color="#5A3F28" />
      <SolidColorBrush x:Key="SuggestionCardBrush" Color="#241E1A" />
      <!-- Scrollbalken: Fluents eigene Keys überschrieben (App-Ressourcen gehen vor die des
           Themes). Die Namen stammen aus den Ressourcen des geladenen FluentTheme, nicht geraten.
           PanningThumb ist der dünne Strich im eingeklappten Zustand — vorher fast schwarz. -->
      <Color x:Key="ScrollBarThumbBackgroundColor">#6E6056</Color>
      <Color x:Key="ScrollBarPanningThumbBackgroundColor">#6E6056</Color>
      <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#6E6056" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#8C7B6B" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#D2693C" />
      <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#2A221D" />
      <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#2A221D" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ── Statusfarben ──────────────────────────────────────────────────────── -->

  <!-- Danger/Abwesenheit: Krank, Löschen, Ablehnen. -->
  <SolidColorBrush x:Key="DangerBrush" Color="#B23A2E" />
  <!-- Flächige Danger-Hinterlegung (Zellen, Badges) — bewusst durchscheinend, damit die
       Personenfarbe darunter erkennbar bleibt. -->
  <SolidColorBrush x:Key="DangerFillBrush" Color="#33B23A2E" />
  <!-- Sehr dezente Danger-Tönung für ganze Zeilen. -->
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1AB23A2E" />
  <SolidColorBrush x:Key="DangerStrongBrush" Color="#D9483B" />
  <!-- Schließen-Hover der Titelleiste (Windows-Konvention: kräftiges Rot, weißes Kreuz). -->
  <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#D93A2B" />
  <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#B02E22" />

  <!-- Erfolg/Zusage: Genehmigen, bestätigter Tausch. -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#5E8E3E" />
  <SolidColorBrush x:Key="SuccessHoverBrush" Color="#4F7A33" />

  <!-- Warnung/Wartend: Urlaubswunsch ohne Entscheidung, Konflikthinweise. -->
  <SolidColorBrush x:Key="WarningBrush" Color="#D98A1F" />

  <!-- Danger-Hover für flächige Lösch-Buttons. -->
  <SolidColorBrush x:Key="DangerPressedBrush" Color="#8F2E24" />

  <!-- Information/Hinweis: gedecktes Petrol statt Blau — hebt sich von Warnung (Orange) und
       Akzent (Terrakotta) ab, ohne kühl zu wirken. -->
  <SolidColorBrush x:Key="InfoBrush" Color="#2E8A80" />
  <SolidColorBrush x:Key="InfoStrongBrush" Color="#23736A" />
  <SolidColorBrush x:Key="InfoFillBrush" Color="#1A2E8A80" />

  <!-- ── Hinweiskarten (helle Flächen mit dunkler Schrift) ─────────────────── -->

  <!-- KI-Hinweise: warmer Gelbton, damit sie sich vom regulären Plan abheben. -->
  <SolidColorBrush x:Key="NoteBackgroundBrush" Color="#FFF6E0" />
  <SolidColorBrush x:Key="NoteForegroundBrush" Color="#7A4500" />
  <!-- Feiertags-/Ferienmarkierung im Kalender. -->
  <SolidColorBrush x:Key="HolidayBackgroundBrush" Color="#FFF1A8" />
  <SolidColorBrush x:Key="HolidayBorderBrush" Color="#D4A300" />
  <SolidColorBrush x:Key="HolidayForegroundBrush" Color="#4A3A00" />
  <!-- ── Neutrale Flächen ──────────────────────────────────────────────────── -->

  <!-- Auswahl-Hinterlegung im Eintrags-Editor. -->
  <SolidColorBrush x:Key="SelectionFillBrush" Color="#225B4B8A" />
  <!-- Neutrale Abtönung für deaktivierte Bereiche. -->
  <SolidColorBrush x:Key="MutedFillBrush" Color="#22808080" />

  <!-- ── Overlays und Trennlinien (auf dunklem Grund) ──────────────────────── -->

  <SolidColorBrush x:Key="OverlayLightBrush" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="OverlayMediumBrush" Color="#55FFFFFF" />
  <SolidColorBrush x:Key="OverlayStrongBrush" Color="#E6FFFFFF" />

  <!-- Abdunkelung hinter modalen Overlay-Dialogen (Browser-Head). -->
  <SolidColorBrush x:Key="ScrimLightBrush" Color="#33000000" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
  <SolidColorBrush x:Key="ScrimStrongBrush" Color="#B0000000" />
  <SolidColorBrush x:Key="ScrimHeavyBrush" Color="#CC000000" />
  <SolidColorBrush x:Key="ShadowBrush" Color="#000000" />

  <!-- ── Marke ─────────────────────────────────────────────────────────────── -->

  <!-- Feste Markenfarbe für Kopf- und Titelleiste (nicht benutzerabhängig): ein Verlauf von
       dunkler Terrakotta zu Kupfer. Weiße Schrift bleibt auf beiden Enden lesbar. -->
  <LinearGradientBrush x:Key="AppHeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#7A2E1C" />
    <GradientStop Offset="1" Color="#B4532A" />
  </LinearGradientBrush>
  <!-- Buy me a coffee: Farben gehören der Marke, nicht dem Theme. -->
  <SolidColorBrush x:Key="CoffeeBrush" Color="#FFDD00" />
  <SolidColorBrush x:Key="CoffeeForegroundBrush" Color="#0D0C22" />

</ResourceDictionary>
