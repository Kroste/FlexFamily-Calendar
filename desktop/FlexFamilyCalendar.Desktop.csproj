<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>FlexFamilyCalendar</RootNamespace>
    <!-- Setzt das Icon der Windows-.exe (Explorer/Alt-Tab). Das Fenster-Icon kommt zusätzlich
         über die PNG-Ressource in MainWindow.axaml. -->
    <ApplicationIcon>..\src\Assets\flexfamily-calendar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel für die lokale Design-Test-API (DesignApi/). Kommt über das Shared Framework,
         nicht als NuGet-Paket — ein PackageReference darauf löst NU1510 aus. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\FlexFamilyCalendar.csproj" />
  </ItemGroup>
</Project>
