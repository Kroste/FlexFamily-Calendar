<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${tempdir}/FlexFamilyCalendar.Api/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- ${masked:inner=${message}} maskiert Passwörter, Tokens und Connection-String-
       Credentials. Der Renderer registriert sich über einen ModuleInitializer, damit er
       auch im Testprozess (kein Main) vor dem ersten Logger steht. Bewusst direkt im
       Layout statt über eine <variable> — ob NLog einen Variablenwert erneut als Layout
       interpretiert, ist nicht garantiert, und ein stiller Ausfall der Maskierung wäre
       genau das, was hier nicht passieren darf. -->
  <!-- Das Log-Verzeichnis kommt über FFC_LOG_DIR (im Container auf ein Volume gelegt).
       Ohne die Variable landet die Datei im Temp-Verzeichnis — wichtig für Tests und
       lokale Läufe, die auf /var/log keine Schreibrechte haben. -->

  <targets>
    <target xsi:type="File"
            name="logfile"
            fileName="${environment:FFC_LOG_DIR:whenEmpty=${tempdir}/FlexFamilyCalendar.Api}/api-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger:shortName=true} | ${masked:inner=${message}}${exception:format=toString,Data:separator=&#13;&#10;}"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            encoding="utf-8"
            createDirs="true" />

    <!-- Container-Logs (docker logs / Watchtower-Diagnose) laufen über stdout. -->
    <target xsi:type="Console"
            name="console"
            layout="${time} | ${level:uppercase=true} | ${logger:shortName=true} | ${masked:inner=${message}}${onexception:inner= | ${exception:format=toString}}" />
  </targets>

  <rules>
    <!-- Die Request-Middleware liefert die kompakte Zeile pro Aufruf; ASP.NETs eigenes
         Request-Logging bleibt deshalb auf Warn, sonst steht jeder Aufruf doppelt drin. -->
    <logger name="Microsoft.AspNetCore.*" minlevel="Warn" writeTo="console,logfile" final="true" />
    <logger name="Microsoft.EntityFrameworkCore.Database.Command" minlevel="Warn" writeTo="console,logfile" final="true" />
    <logger name="Microsoft.*" minlevel="Info" writeTo="console,logfile" final="true" />
    <logger name="*" minlevel="Trace" writeTo="logfile" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
