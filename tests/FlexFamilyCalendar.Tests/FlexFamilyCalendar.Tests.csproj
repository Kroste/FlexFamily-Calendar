<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit.v3 generiert einen eigenen Entry-Point und MUSS ausführbar sein. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMinVer>false</UseMinVer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlexFamilyCalendar.csproj" />
    <!-- Die Design-Test-API liegt im Desktop-Head (Kestrel gehört nicht in die geteilte
         Bibliothek, Browser und Android könnten es nicht laden). Getestet werden nur die
         UI-freien Teile: Options-Parser und Sperrliste. -->
    <ProjectReference Include="..\..\desktop\FlexFamilyCalendar.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLogConfigTests lädt die echte Config — sie muss also auch im Test-Output liegen. -->
    <Content Include="..\..\src\nlog.config" Link="nlog.config" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
